<%- include('partials/head', {
  title: 'Meu pedido',
  page: 'pedido',
  headExtra: order.downloadUrl && (!order.deliveryExtras || order.deliveryExtras.length === 0)
    ? `<meta http-equiv="refresh" content="3;url=${order.downloadUrl}">`
    : ''
}) %>
<main class="container page narrow">
  <section class="card">
    <h1>Status do pedido</h1>

    <div class="order-status">
      <% const labels = {
        pending: 'Aguardando pagamento',
        paid: 'Pagamento confirmado',
        delivered: 'Aprovado e entregue',
        needs_compile: 'Pagamento aprovado - compilando...',
        error: 'Erro no processamento'
      }; %>
      <span class="status status-<%= order.status %>"><%= labels[order.status] || order.status %></span>
    </div>

    <p class="muted">Pedido: <%= order.id %></p>

    <p>Plugin: <strong><%= order.pluginName %></strong></p>
    <% if (order.customTag) { %>
      <p>Tag: <strong><%= order.customTag %></strong></p>
    <% } %>
    <p>Valor: <strong>R$ <%= Number(order.price).toFixed(2) %></strong></p>

    <% if (order.downloadUrl) { %>
      <% const files = [
           { name: order.deliveryName || 'plugin.amxx', url: order.downloadUrl, main: true }
         ].concat((order.deliveryExtras || []).filter(e => e.name).map(e => ({
           name: e.name,
           url: `/download/${order.id}/${e.name}`
         }))); %>
      <div class="alert success">
        <% if (files.length === 1) { %>
          <p>Seu plugin está pronto para download! Iniciando o download automaticamente...</p>
        <% } else { %>
          <p>Seu pacote está pronto! Baixe todos os arquivos abaixo:</p>
        <% } %>
        <div class="downloads">
          <% files.forEach(f => { %>
            <a href="<%= f.url %>" class="btn-primary"><%= f.main ? 'Baixar plugin (.amxx)' : ('Baixar ' + f.name) %></a>
          <% }) %>
        </div>
      </div>
    <% } else if (order.status === 'needs_compile') { %>
      <p class="muted">Pagamento confirmado. Seu plugin está sendo preparado — em breve o download do <code>.amxx</code> aparecerá aqui.</p>
    <% } else if (order.status === 'pending') { %>
      <p class="muted">Assim que o pagamento for aprovado, o download aparecerá aqui automaticamente.</p>
    <% } %>
  </section>
</main>
<%- include('partials/tail') %>