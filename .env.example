# ===== Servidor =====
PORT=3000
NODE_ENV=development
# URL pública do site (no Render será https://seuapp.onrender.com)
APP_URL=http://localhost:3000

# ===== Mercado Pago =====
# Access Token de produção (ou test para testes)
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxx
# Para modo de testes use TEST-xxxx
MP_PUBLIC_KEY=APP_PUB-xxxxxxxxxxxxx

# ===== Modo demo (teste local sem Mercado Pago) =====
# ative com "on" para simular pagamento aprovado automaticamente
# Se MP_ACCESS_TOKEN estiver vazio, o modo demo é ativado sozinho
DEMO_MODE=on

# ===== Discord (opcional) =====
# URL do webhook do seu canal do Discord (para receber avisos de vendas/sugestões)
# Crie em: https://discord.com/api/webhooks/xxxxx/yyyyy
DISCORD_WEBHOOK_URL=

# Segredo para validar os webhooks (invente uma string longa)
WEBHOOK_SECRET=uma-string-secreta-bem-longa-e-aleatoria

# ===== Aprovação de pedidos =====
# "auto" = entrega automaticamente após pagamento aprovado
# "manual" = você aprova manualmente pelo painel admin
APPROVAL_MODE=auto

# ===== Admin =====
# Senha do painel de admin
ADMIN_PASSWORD=mude-essa-senha

# ===== Compilador =====
# Caminho para o executável do compilador AMXX (amxxpc.exe no Windows / amxxpc no Linux)
# Local (Windows): C:\caminho\para\scripting\amxxpc.exe
# Render (Linux):  /app/compiler/addons/amxmodx/scripting/amxxpc
# O .amxx é a entrega OBRIGATÓRIA. Sem compilador, os pedidos ficam pendentes de compilação manual.
AMXXPC_PATH=
